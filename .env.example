# GID 2.0 Environment Variables Example
# Copy this file to .env.local and fill in the actual values

# Gemini API Key (optional, for CodeBlock Python/JS assistance if integrated)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (for Drive backup feature)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173

# Cloudflare Pages / R2 (for production deployment)
# These are set as GitHub Actions secrets, not in .env
# - CLOUDFLARE_API_TOKEN
# - CLOUDFLARE_ACCOUNT_ID
# - CLOUDFLARE_PROJECT_NAME
# - CLOUDFLARE_R2_BUCKET (for future Pyodide WASM hosting)
